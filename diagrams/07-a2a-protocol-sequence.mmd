config:
  theme: base
  sequence:
    actorMargin: 95
    width: 175
    height: 55
    messageMargin: 45
    noteMargin: 20
    boxMargin: 15
    mirrorActors: false
  themeVariables:
    fontFamily: Arial
    fontSize: 15px
    primaryColor: "#EAF3FC"
    primaryBorderColor: "#397AB9"
    primaryTextColor: "#172B4D"
    actorBkg: "#EAF3FC"
    actorBorder: "#397AB9"
